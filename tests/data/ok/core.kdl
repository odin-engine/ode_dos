namespace "core"

meta "Wooden" priority=0 {
    can-attach-rope #true
    footstep-sound "wood"
}

meta "Alert" priority=50 {
    vision-range 45.0
}

archetype "Physical" {
    mass 10.0
}

archetype "Creature" parent="Physical" {
    max-hit-points 100
}

archetype "Human" parent="Creature" {
    max-air-supply-ms 10000
    ai {
        vision-range 20.0
    }
}

archetype "Guard" parent="Human" {
    ai {
        vision-range 30.0
    }
    meta "Alert"
}

archetype "Sword" parent="Physical" {
    mass 2.0
}

surface "WoodPlanks" {
    meta "Wooden"
}
